# Copy to .env.local (gitignored). `npx convex dev` also writes CONVEX_DEPLOYMENT here.
EXPO_PUBLIC_CONVEX_URL=https://elegant-owl-354.convex.cloud

# The ingest worker's Claude credential, from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# The closet key: the same value as CLOSET_KEY on the Convex deployment.
# CLOSET_KEY is read by the ingest worker; EXPO_PUBLIC_CLOSET_KEY is baked into
# the app at build time, so rebuild the APK after setting it.
CLOSET_KEY=
EXPO_PUBLIC_CLOSET_KEY=
