# Copy to .env.local. Same deployment the camera app writes to
# (camera-wardrobe-ingestion/eas.json has it as EXPO_PUBLIC_CONVEX_URL).
VITE_CONVEX_URL=https://elegant-owl-354.convex.cloud

# For the stylist worker only. Never prefix these with VITE_, or Vite would
# ship them to the browser.
# Get one with `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=
# The same value as CLOSET_KEY on the Convex deployment (see the root README):
CLOSET_KEY=
